{
  "name": "printmax",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "Self-hosted upload-and-print web app that talks IPP directly to network printers",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "check": "tsc --noEmit",
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dump-caps": "tsx scripts/dump-caps.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@types/node": "^24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
