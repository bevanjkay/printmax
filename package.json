{
  "name": "printmax",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "description": "Self-hosted upload-and-print web app that talks IPP directly to network printers",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "check": "tsc --noEmit",
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dump-caps": "tsx scripts/dump-caps.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@modelcontextprotocol/server": "^2.4.0",
    "bonjour-service": "^1.4.4",
    "fastify": "^5.12.8",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@eslint-react/eslint-plugin": "^5.30.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
